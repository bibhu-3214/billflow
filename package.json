    "dev:local": "node scripts/dev-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:app": "eslint src --ignore-pattern '**/*.test.{ts,tsx}' --ignore-pattern 'src/testing/**' --max-warnings 0",
    "lint:native": "eslint native --max-warnings 0",
    "check": "npm run typecheck && npm run lint"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.13.0 <25"
