    "test": "jest",
    "test:tooling": "node --test scripts/*.test.cjs",
    "test:browser": "playwright test",
    "pdf:samples": "node scripts/pdf-samples.cjs output/pdf",
    "build:connected": "npm run lint:app && tsc --noEmit -p tsconfig.app.json && REACT_APP_ACCOUNT_BACKEND=django vite build",
